{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "archlinux",
    "type": "builtin",
    "color": {
      "1": "#6ee7ff",
      "2": "#0ea5e9",
      "3": "#d8f7ff"
    }
  },
  "display": {
    "separator": " -> ",
    "size": {
      "max": 80
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "desktop",
    "wm",
    "memory",
    "break",
    "colors"
  ]
}
